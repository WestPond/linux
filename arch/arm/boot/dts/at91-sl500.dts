/dts-v1/;
#include "at91sam9g25.dtsi"

/ {
	model = "Systech SL500";
	compatible = "systech,sl500", "atmel,at91sam9x5", "atmel,at91sam9";

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	memory {
		reg = <0x20000000 0x8000000>;
	};

	clocks {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		main_clock: clock@0 {
			compatible = "atmel,osc", "fixed-clock";
			clock-frequency = <12000000>;
		};
	};

	ahb {
		apb {
			macb0: ethernet@f802c000 {
				phy-mode = "mii";
				pinctrl-0 = <
					&pinctrl_macb0_rmii
					&pinctrl_macb0_rmii_mii>;
				status = "okay";
			};

			mmc0: mmc@f0008000 {
				pinctrl-0 = <
					&pinctrl_board_mmc0
					&pinctrl_mmc0_slot0_clk_cmd_dat0
					&pinctrl_mmc0_slot0_dat1_3>;
				status = "okay";
				slot@0 {
					reg = <0>;
					bus-width = <4>;
					cd-gpios = <&pioD 15 0>;
				};
			};

			dbgu: serial@fffff200 {
				status = "okay";
			};

			usart0: serial@f801c000 {
				status = "okay";
			};

			pinctrl@fffff400 {
				mmc0 {
					pinctrl_board_mmc0: mmc0-board {
						atmel,pins =
							<3 15 0x0 0x5>;	/* PD15 gpio CD pin pull up and deglitch */
					};
				};
			};

			i2c1: i2c@f8014000 {
				status = "okay";

		        eeprom@50 {
					compatible = "at,24c02";
		            pagesize = <16>;
					reg = <0x50>;
		        };

				accel@18 {
					compatible = "bosch,bma250";
					reg = <0x18>;
				};
			};

			spi0: spi@f0000000 {
				status = "okay";
				cs-gpios = <&pioA 14 0>, <0>, <0>, <0>;

				mtd_dataflash@0 {
					#address-cells = <1>;
					#size-cells = <1>;
					compatible = "atmel,at45", "atmel,dataflash";
					spi-max-frequency = <50000000>;
					reg = <0>;

					bootstrap@0 {
						label = "bootstrap";
						reg = < 0x0 0x4200 >;
					};
					env@4200 {
						label = "env";
						reg = < 0x4200 0x4200 >;
					};
					u-boot@8400 {
						label = "u-boot";
						reg = < 0x8400 0x80010 >;
					};
				};
			};

			watchdog@fffffe40 {
				status = "okay";
			};
		};

		ebi: ebi@10000000 {
			pinctrl-0 = <&pinctrl_ebi_addr_nand &pinctrl_ebi_data_0_7>;
			pinctrl-names = "default";
			status = "okay";

			nand_controller: nand-controller {
				pinctrl-0 = <&pinctrl_nand_oe_we &pinctrl_nand_cs &pinctrl_nand_rb>;
				pinctrl-names = "default";
				status = "okay";

				nand: nand@3 {
					reg = <0x3 0x0 0x800000>;
					rb-gpios = <&pioD 5 GPIO_ACTIVE_HIGH>;
					cs-gpios = <&pioD 4 GPIO_ACTIVE_HIGH>;
					atmel,nand-has-dma;
					nand-bus-width = <8>;
					nand-ecc-mode = "hw";
					atmel,has-pmecc;    /* Enable PMECC */
					atmel,pmecc-cap = <2>;
					atmel,pmecc-sector-size = <512>;
					nand-on-flash-bbt;
					label = "atmel_nand";

					partitions {
						compatible = "fixed-partitions";
						#address-cells = <1>;
						#size-cells = <1>;

						kernel0@0 {
							label = "kernel0";
							reg = <0x0 0x1000000>;
						};
						kernel1@1000000 {
							label = "kernel1";
							reg = <0x1000000 0x1000000>;
						};
						data@2000000 {
							label = "data";
							reg = <0x2000000 0xE000000>;
						};
					};
				};
			};
		};

		usb0: ohci@00600000 {
			status = "okay";
			num-ports = <2>;
			atmel,vbus-gpio = <&pioD 19 1
					   &pioD 20 1
					  >;
		};

		usb1: ehci@00700000 {
			status = "okay";
		};
	};

	sl500-leds {
        compatible = "systech,sl500-leds";
	};

	gpio_keys {
		compatible = "gpio-keys";

		F12 {
			label = "reset";
			gpios = <&pioC 19 1>;
			linux,code = <88>;
		};
	};
};
